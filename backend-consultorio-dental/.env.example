# Copy this file to .env and adjust the values
# cp .env.example .env

# Prisma uses this URL to connect to the database.
# • Locally without Docker: use "localhost" or your server's IP
# • With docker compose this file is NOT used: the backend receives DATABASE_URL
#   from docker-compose.yml (host "db"). See the Docker section of the README.
DATABASE_URL="postgresql://tu_user:123@localhost:5432/tu_db"

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tu_db
DATABASE_USER=tu_user
DATABASE_PASSWORD=123

ON_PRODUCTION=false

JWT_SECRET=

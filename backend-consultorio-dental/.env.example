# Copy this file to .env and adjust the values
# cp .env.example .env

# Prisma uses this URL to connect to the database.
# • Locally without Docker: use "localhost" or your server's IP
# • With docker compose this file is NOT used: the backend receives DATABASE_URL
#   from docker-compose.yml (host "db"). See the Docker section of the README.
DATABASE_URL="postgresql://tu_user:123@localhost:5432/tu_db"

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tu_db
DATABASE_USER=tu_user
DATABASE_PASSWORD=123

ON_PRODUCTION=false

# Obligatorio: la app no arranca sin él. Usa un valor largo y aleatorio.
# En producción (ON_PRODUCTION=true o NODE_ENV=production) se rechaza el valor de ejemplo
# 'dentissa-dev-secret-cambiar' y cualquier secreto de menos de 32 caracteres.
JWT_SECRET=

# Origen del frontend: CORS y enlace del correo de recuperación (`${FRONTEND_URL}/restablecer-contrasena?token=...`).
FRONTEND_URL=http://localhost:5173

# Número de proxies inversos de confianza delante del backend (entero >= 0, por defecto 0).
# Afecta a la IP real usada por el rate limit. Nunca se acepta 'true'.
TRUST_PROXY_HOPS=0

# Cookies de sesión: `secure` se activa con ON_PRODUCTION=true (o NODE_ENV=production).
# COOKIE_SAMESITE: lax (defecto) | strict | none (none fuerza secure).
COOKIE_SAMESITE=lax

# Correo (nodemailer) para recuperación de contraseña. Si SMTP_HOST/SMTP_USER/SMTP_PASS
# están vacíos, POST /auth/forgot-password responde 503 (no se simula el envío).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dentissa <no-reply@example.com>"


# Contraseña del administrador inicial creado por `prisma/seed.ts` (minimo 10 caracteres).
# Obligatoria para ejecutar el seed; no se imprime en consola.
SEED_ADMIN_PASSWORD=

# Zona horaria del consultorio para validar horarios de citas (IANA). Por defecto America/Mexico_City.
APP_TIMEZONE=America/Mexico_City

# Carpeta de archivos subidos (imagenes de consultas, servicios y ofertas). Por defecto ./storage.
# Nunca se sirve como estatico: solo por endpoints del backend. En Docker, montar un volumen aqui.
# STORAGE_DIR=./storage

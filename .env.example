# Variables for docker compose (optional).
# Copy this file to .env in the repository root to override the default values:
#   cp .env.example .env
# If .env does not exist, docker-compose.yml uses the default values shown here.

DATABASE_USER=dentissa
DATABASE_PASSWORD=dentissa
DATABASE_NAME=dentissa
# Host port where PostgreSQL is published (5433 to avoid clashing with a local PostgreSQL on 5432)
DATABASE_PORT=5433

# Secret used to sign the JWTs. Replace it with a long random value.
JWT_SECRET=dentissa-dev-secret-cambiar

# URL the browser uses to reach the backend (embedded when the frontend is built)
VITE_API_URL=http://localhost:3000

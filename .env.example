# Variables for docker compose (optional).
# Copy this file to .env in the repository root to override the default values:
#   cp .env.example .env
# If .env does not exist, docker-compose.yml uses the default values shown here.

DATABASE_USER=dentissa
DATABASE_PASSWORD=dentissa
DATABASE_NAME=dentissa
# Host port where PostgreSQL is published (5433 to avoid clashing with a local PostgreSQL on 5432)
DATABASE_PORT=5433

# Secret used to sign the JWTs (REQUIRED, no default). Use a random value of at
# least 32 characters, e.g.: openssl rand -hex 32
JWT_SECRET=

# Initial administrator password created by the seed (required, at least 10 characters)
SEED_ADMIN_PASSWORD=

# Optional backend settings (empty = backend defaults).
# Frontend origin: CORS and password-reset link (default http://localhost:5173)
FRONTEND_URL=
# Cookie SameSite: lax (default) | strict | none
COOKIE_SAMESITE=
# Number of reverse proxies in front of the backend (default 0). Never 'true'.
TRUST_PROXY_HOPS=
# SMTP for password recovery. If empty, POST /auth/forgot-password responds 503.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# URL the browser uses to reach the backend (embedded when the frontend is built)
VITE_API_URL=http://localhost:3000
